# public/api/uploads/.htaccess
# Tillat visning og nedlasting av bilder, men forhindre enhver kjøring av skriptfiler

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Skru av skriptkjøring dersom mod_php er aktiv
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
