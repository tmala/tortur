# TorTur – Miljøvariabler
# Kopier denne filen til .env og fyll inn verdiene.
# .env er i .gitignore og skal ALDRI committes til git.

# Google OAuth Client ID (fra Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=<din-google-client-id>.apps.googleusercontent.com

# Google Apps Script Web App deployment-URL
# Publiser appscript.js som Web App i Google Regneark, og lim inn URL her.
VITE_APPSCRIPT_URL=https://script.google.com/macros/s/<deployment-id>/exec

# Google Spreadsheet ID (brukes kun av Apps Script – ikke i frontend)
VITE_SPREADSHEET_ID=<google-spreadsheet-id>

# Firebase Configuration
VITE_FIREBASE_API_KEY=<din-firebase-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<ditt-prosjekt>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<ditt-prosjekt-id>
VITE_FIREBASE_DB_URL=https://<ditt-prosjekt>-default-rtdb.europe-west1.firebasedatabase.app/
VITE_FIREBASE_APP_ID=<din-firebase-app-id>

# Diverse (valgfritt)
VITE_API_URL=
