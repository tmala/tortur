{
  "rules": {
    ".read": false,
    ".write": false,
    "$prefix": {
      "turposter": {
        "$turpostId": {
          ".read": "auth != null",
          "$checkinId": {
            ".write": "auth != null",
            ".validate": "!newData.hasChild('userId') || newData.child('userId').isString() || (data.child('userId').exists() && data.child('userId').val() == newData.child('userId').val())",
            "likes": {
              ".read": "auth != null",
              "$likeUserId": {
                ".write": "auth != null"
              }
            },
            "comments": {
              ".read": "auth != null",
              "$commentId": {
                ".write": "auth != null"
              }
            }
          }
        }
      },
      "auth_uids": {
        "$authUid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $authUid"
        }
      },
      "brukere": {
        "$userId": {
          "auth_uid": {
            ".read": "auth != null",
            ".write": "auth != null && (!data.exists() || data.val() == auth.uid || root.child($prefix).child('auth_uids').child(auth.uid).val() == $userId)"
          },
          "friends": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "friend_requests": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "friends_checkins": {
            ".read": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid || root.child($prefix).child('brukere').child($userId).child('friends').child(root.child($prefix).child('auth_uids').child(auth.uid).val()).exists())",
            ".write": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)",
            "$checkinId": {
              ".validate": "!newData.hasChild('userId') || newData.child('userId').isString() || (data.child('userId').exists() && data.child('userId').val() == newData.child('userId').val())"
            }
          },
          "private_checkins": {
            ".read": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)",
            ".write": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)",
            "$checkinId": {
              ".validate": "!newData.hasChild('userId') || newData.child('userId').isString() || (data.child('userId').exists() && data.child('userId').val() == newData.child('userId').val())"
            }
          },
          "checkins": {
            ".read": "auth != null",
            ".write": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)",
            "$checkinId": {
              ".validate": "!newData.hasChild('userId') || newData.child('userId').isString() || (data.child('userId').exists() && data.child('userId').val() == newData.child('userId').val())"
            }
          },
          "my_spots": {
            ".read": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)",
            ".write": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)"
          },
          "my_spots_checkins": {
            ".read": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)",
            ".write": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)",
            "$spotId": {
              "$checkinId": {
                ".validate": "!newData.hasChild('userId') || newData.child('userId').isString() || (data.child('userId').exists() && data.child('userId').val() == newData.child('userId').val())"
              }
            }
          },
          "settings": {
            ".read": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)",
            ".write": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)"
          },
          "tracks": {
            ".read": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid || root.child($prefix).child('brukere').child($userId).child('friends').child(root.child($prefix).child('auth_uids').child(auth.uid).val()).exists())",
            ".write": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)"
          },
          "track_photos": {
            ".read": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)",
            ".write": "auth != null && (!root.child($prefix).child('brukere').child($userId).child('auth_uid').exists() || root.child($prefix).child('brukere').child($userId).child('auth_uid').val() == auth.uid)",
            "$trackKey": {
              ".read": "auth != null && root.child($prefix).child('brukere').child($userId).child('tracks').child($trackKey).child('sharePhotosWithFriends').val() == true && root.child($prefix).child('brukere').child($userId).child('friends').child(root.child($prefix).child('auth_uids').child(auth.uid).val()).exists()"
            }
          }
        }
      },
      "checkins_visibility": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "users_public": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "spot_suggestions": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "admins": {
        ".read": "auth != null",
        "$authUid": {
          ".write": "auth != null && (root.child($prefix).child('admins').child(auth.uid).val() == true || !root.child($prefix).child('admins').exists())"
        }
      },
      "approved_spots": {
        ".read": "auth != null",
        ".write": "auth != null && root.child($prefix).child('admins').child(auth.uid).val() == true"
      }
    }
  }
}
