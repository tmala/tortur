{
  "name": "tortur",
  "version": "0.3.32",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:data": "node scripts/build-data.js",
    "sync:spots": "node scripts/sync-approved-spots.js",
    "build:icons": "node scripts/generate-favicons.js",
    "build": "npm run build:data && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "deploy": "zsh deploy.sh"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "firebase": "^13.0.0",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "maplibre-gl": "^6.11.2",
    "piexifjs": "^1.0.6",
    "pinia": "^4.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/piexifjs": "^1.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.87.0",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
