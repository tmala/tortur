{
  "name": "tortur",
  "version": "0.3.55",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:data": "node scripts/build-data.js",
    "sync:spots": "node scripts/sync-approved-spots.js",
    "sync:spots:clean": "node scripts/sync-approved-spots.js --delete-exported",
    "build:icons": "node scripts/generate-favicons.js",
    "build": "npm run build:data && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "deploy": "zsh deploy.sh"
  },
  "dependencies": {
    "@lucide/vue": "^1.77.0",
    "exifr": "^7.1.3",
    "firebase": "^13.4.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.19.0",
    "piexifjs": "^1.0.6",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "vite-plugin-pwa": "^2.0.0",
    "@playwright/test": "^1.65.1",
    "@tsconfig/node24": "^24.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/piexifjs": "^1.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vitest/ui": "^5.1.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.94.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.10.1",
    "typescript": "~6.0.0",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^24.18.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "serialize-javascript": "^7.1.4"
  }
}
